rules_version = '2';

// Deny by default. Packs are read-only to everyone signed in (anonymous included).
// The only thing a client may write is a lookup request: a masked line item and a region, nothing else.
service cloud.firestore {
  match /databases/{database}/documents {
    match /packs/{packId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /items/{itemId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /requests/{requestId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['item', 'region', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.item is string
        && request.resource.data.item.size() > 0
        && request.resource.data.item.size() <= 120
        && request.resource.data.region is string
        && request.resource.data.region.matches('^[A-Z]{2}(-[A-Z0-9]{1,3})?$')
        && request.resource.data.createdAt == request.time
        // No long digit runs or @ signs: a second line of defence behind the client-side mask.
        && !request.resource.data.item.matches('.*[0-9]{7,}.*')
        && !request.resource.data.item.matches('.*@.*');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
